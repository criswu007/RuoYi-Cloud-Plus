<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.address.mapper.AddrSetSegmMapper">

    <select id="countBySegmIds" resultType="java.lang.Long">
        select count(1)
        from ADDR_SET_SEGM
        where coalesce(delete_state, '0') = '0'
          and segm_id in
          <foreach collection="segmIds" item="segmId" open="(" separator="," close=")">
              #{segmId}
          </foreach>
    </select>

    <update id="rebindSegmIds">
        update ADDR_SET_SEGM
        set segm_id = #{targetSegmId}
        where coalesce(delete_state, '0') = '0'
          and segm_id in
          <foreach collection="sourceSegmIds" item="segmId" open="(" separator="," close=")">
              #{segmId}
          </foreach>
    </update>

</mapper>
